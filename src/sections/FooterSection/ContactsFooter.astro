---
import { Icon } from "astro-icon/components";
---

<article class="flex flex-col text-left">
    <h4 class="text-xl font-semibold text-white mb-4">Контакты</h4>

    <div class="text-gray-400 flex items-center gap-2 mb-3">
        <div>
            <Icon name="phone" size="20" color="oklch(71.4% 0.203 305.504)" />
        </div>
        <a
            href="tel:+79999999999"
            class="hover:text-white transition-all duration-300"
            >+7 (999) 999-99-99</a
        >
    </div>
    <div class="text-gray-400 flex items-center gap-2 mb-3">
        <div>
            <Icon name="mail" size="20" color=" oklch(71.4% 0.203 305.504)" />
        </div>
        <a
            href="mailto:d.kuks@yandex.ru"
            class="hover:text-white transition-all duration-300"
            >email@example.com</a
        >
    </div>
    <div class="text-gray-400 flex items-center gap-2 mb-3">
        <div>
            <Icon name="mappin" size="20" color=" oklch(71.4% 0.203 305.504)" />
        </div>
        <address>г. Санкт-Петербург, Невский проспект, 100</address>
    </div>
</article>
