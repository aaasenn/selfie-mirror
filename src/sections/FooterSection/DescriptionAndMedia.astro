---
import SocialMediaLink from "./SocialMediaLink.astro";
---

<div class="flex flex-col gap-2 text-left">
    <h4 class="text-xl font-semibold text-purple-400 mb-4">Селфи зеркало</h4>
    <p class="text-gray-400 mb-3">
        Аренда интерактивных селфи-зеркал для незабываемых мероприятий в
        Санкт-Петербурге и по всей России.
    </p>
    <nav class="flex gap-4">
        <SocialMediaLink iconName="instagram" href="instagram.com" />
        <SocialMediaLink iconName="vk" href="vk.com" />
        <SocialMediaLink iconName="telegram" href="telegram.com" />
    </nav>
</div>
