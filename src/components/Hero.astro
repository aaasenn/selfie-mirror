---
import Card from "./Card.astro";
import Button from "./Button.vue";
import OrderButton from "./OrderButton.vue";
import background from "../assets/selfie-mirror-background.png";
import { Image } from "astro:assets";
import PhoneButtonAstroComponent from "./PhoneButton.vue";
---

<section class="min-h-screen w-full">
    <div class="absolute w-full h-full">
        <Image
            src={background}
            alt="background"
            class="w-full h-full object-cover"
        />
    </div>
    <div class="absolute inset-0 primary-gradient opacity-50"></div>
    <div
        class="container min-h-screen mx-auto px-4 flex items-center justify-center"
    >
        <div class="flex flex-col gap-6 max-w-4xl w-full text-center z-100">
            <h1 class="text-primaryText font-bold max-sm:text-4xl md:text-7xl">
                Селфи зеркало <span class="text-yellow-300"
                    >для вашего праздника</span
                >
            </h1>
            <p class="max-sm:text-xl md:text-2xl text-primaryText">
                Аренда интерактивных селфи-зеркал в Санкт-Петербурге и по всей
                России. Незабываемые фото на свадьбах, корпоративах, днях
                рождения и любых мероприятиях!
            </p>

            <div class="flex-center gap-2">
                <OrderButton client:load />
                <PhoneButtonAstroComponent />
            </div>

            <div class="flex-center justify-between max-sm:flex-col">
                <Card title="50+" description="проведенных мероприятий" />
                <Card title="5 лет" description="на рынке" />
                <Card title="100%" description="довольных клиентов" />
            </div>
        </div>
    </div>
</section>
